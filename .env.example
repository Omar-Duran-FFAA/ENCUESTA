# Copiar a .env y reemplazar TODOS los datos marcados.
NODE_ENV=development
PORT=3001
# PostgreSQL local. Si tu contraseña incluye @, :, / o #, usa su codificación URL.
DATABASE_URL=postgresql://postgres:CAMBIAR_CLAVE@localhost:5432/ace_2026
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
# En nube PostgreSQL con SSL activable: true. Local: false.
DB_SSL=false
